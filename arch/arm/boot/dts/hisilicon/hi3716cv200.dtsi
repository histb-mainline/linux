// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * HiSilicon Hi3716CV200 (2x Cortex-A9, 32-bit).
 *
 * Bring-up scaffolding for the AR513W board test: the node set is the one the
 * board itself proves, either from the 3.10 vendor board file
 * (kernel/linux-3.10.y/arch/arm/mach-s40/) or from the 4.4 vendor
 * arch/arm/boot/dts/hi3716cv200.dts. Gates and resets come from the CRG at
 * 0xf8a22000; the sources that have no documented PLL encoding are fixed clocks.
 */

#include <dt-bindings/clock/hisilicon,hi3716cv200-crg.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "HiSilicon Hi3716CV200";
	compatible = "hisilicon,hi3716cv200";
	#address-cells = <1>;
	#size-cells = <1>;

	xtal24mhz: xtal24mhz {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		clock-output-names = "clk24M";
	};

	/*
	 * The fixed sources (clk_3m, clk_83p3m, clk_i2c100m) are registered by
	 * the CRG provider, not here: a bit group reaches its source through a
	 * clk_hw owned by that provider, and a source declared in both places
	 * makes the second registration fail with -EEXIST, which aborts the CRG
	 * probe and leaves every clock, reset and bus consumer of it deferred.
	 */

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x40000000>;
	};

	/*
	 * Not a child of the soc bus: every child of a simple-bus has to be
	 * addressable through its parent's ranges, and this node has no
	 * address of its own. The same shape is used at the top level by
	 * bcm7445.dtsi and rockchip/rk3288-veyron.dtsi.
	 */
	reboot {
		compatible = "syscon-reboot";
		regmap = <&sysctrl>;
		offset = <0x4>;
		mask = <0xdeadbeef>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a9";
			device_type = "cpu";
			reg = <0>;
			enable-method = "hisilicon,hi3716cv200-smp";
		};

		cpu1: cpu@1 {
			compatible = "arm,cortex-a9";
			device_type = "cpu";
			reg = <1>;
			enable-method = "hisilicon,hi3716cv200-smp";
		};
	};

	/*
	 * The cores' performance monitor. There is no register to describe here:
	 * the counters live in the CPU bank the driver reaches through the cp15
	 * accessors, and what the device tree carries is where the overflow
	 * interrupt goes. The Cortex-A9 TRM puts it on private peripheral 6
	 * (GIC INTID 38); the sampling arm of boardtest/cv200-pmucheck.c is what
	 * says whether this SoC keeps that wiring, since the counters themselves
	 * run whether or not the interrupt is delivered.
	 */
	pmu {
		compatible = "arm,cortex-a9-pmu";
		/*
		 * The node sits at the root, where no interrupt-parent is inherited
		 * from: without this line the driver probes and reports
		 * "no irqs for PMU, sampling events not supported".
		 */
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 6 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>, <&cpu1>;
		/*
		 * Inferred, and this property is the test of the inference: the
		 * board is booted by the vendor fastboot with no trusted-firmware
		 * layer, so the kernel is likely running in secure SVC. Measured
		 * 2026-10-22 with the interrupt wired: the armv7 driver announced
		 * 7 counters, /proc/interrupts listed arm-pmu, and yet the cycle
		 * and instruction counters both read 0 across a busy loop and the
		 * PMU interrupt count stayed 0. That is the signature of
		 * non-invasive debug being off -- PMCR/PMCNTENSET stay readable,
		 * the counters just do not tick -- and SDER.SUNIDEN is only
		 * reachable from secure state. If this boots, the state was
		 * secure; if the SDER access traps, it was not, and then the PMU
		 * cannot be enabled from this kernel at all.
		 */
		secure-reg-access;
	};

	/*
	 * The A9 MPCore private peripheral region: SCU at offset 0 of it, the GIC
	 * cpu interface at 0x100 (already described under the gic node). The vendor
	 * kernel reaches the same block through REG_BASE_A9_PERI 0xF8A00000
	 * (mach-s40/include/mach/platform.h:49).
	 */
	scu: scu@f8a00000 {
		compatible = "arm,cortex-a9-scu";
		reg = <0xf8a00000 0x100>;
	};

	/*
	 * The integrated L2C-310. Live reads (2026-10-25, bench devmem): CacheID
	 * 0x410000C9 (PL310 r3p2) at 0xf8a10000, CacheType 0x9e240240, and
	 * AuxCtrl 0x00000000 -- every boot the board has seen (vendor and ours)
	 * leaves the controller disabled; only its clock is up (CRG20 bit4
	 * l2_clkoff_sys = 0). No interrupt is described because the combi IRQ
	 * wiring is unknown and the l2x0 driver does not need one; the vendor
	 * kernels run with CONFIG_CACHE_L2X0 unset, so there is no vendor
	 * register word to copy the aux settings from and the driver's reset
	 * defaults apply.
	 */
	L2: cache-controller@f8a10000 {
		compatible = "arm,pl310-cache";
		reg = <0xf8a10000 0x1000>;
		cache-unified;
		cache-level = <2>;
	};

	soc {
		compatible = "simple-bus";
		interrupt-parent = <&gic>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		gic: interrupt-controller@f8a01000 {
			compatible = "arm,cortex-a9-gic";
			#interrupt-cells = <3>;
			#address-cells = <0>;
			interrupt-controller;
			/* dist base, cpu interface base */
			reg = <0xf8a01000 0x1000>, <0xf8a00100 0x100>;
		};

		/*
		 * mach-s40/timer.c: cell 2 (0xf8a29000) is the clocksource,
		 * cell 3 (+0x20) the clockevent, both on the shared "timer2/3"
		 * line (SPI 25); cells 4 and 6 are the vendor's per-CPU local
		 * timers and are not used here -- the per-CPU event this kernel
		 * takes is the Cortex-A9 private timer below.
		 */
		timer0: timer@f8a29000 {
			/*
			 * "arm,sp804" only, deliberately: this instance answers its registers -- it is the
			 * running clocksource (current_clocksource = arm,sp804) -- but its PrimeCell ID
			 * header reads eight zero words at 0xfe0..0xffc, so listing "arm,primecell" made the
			 * bus core create a device with id 00000000 that nothing can ever match. That orphan
			 * was the whole of the "deferred probe pending" line this node used to print; the
			 * driver here is the OF timer path, which never goes through the AMBA bus.
			 */
			compatible = "arm,sp804";
			reg = <0xf8a29000 0x1000>;
			interrupts = <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal24mhz>, <&xtal24mhz>, <&xtal24mhz>;
			clock-names = "apb_pclk", "timer0", "timer1";
			arm,sp804-has-irq = <2>;
		};

		/*
		 * Per-CPU clock events, one SP804 channel each: cell 4 for cpu0
		 * and cell 6 for cpu1, with their own SPIs -- the vendor picks a
		 * core's channel as hi_timer[(cpu * 2) + 4] and its build for this
		 * chip has HAVE_SP804_LOCAL_TIMER=y with HAVE_ARM_LOCAL_TIMER
		 * unset (mach-s40/timer.c:75, configs/hi3716cv200_defconfig:296).
		 * The Cortex-A9 private timer and global timer are unusable here:
		 * both keep the value written and never count (board-measured, and
		 * drivers/clocksource/timer-histb-smp.c has the numbers).
		 *
		 * The channel rate equals the clocksource cell's, 24 MHz, measured
		 * by counting both down over the same window, so the same fixed
		 * crystal describes them.
		 */
		smp_timer: timer@f8a2a000 {
			compatible = "hisilicon,hi3716cv200-smp-timer";
			reg = <0xf8a2a000 0x20>, <0xf8a2b000 0x20>;
			interrupts = <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&xtal24mhz>;
		};

		sysctrl: system-control@f8000000 {
			compatible = "hisilicon,hi3716cv200-sysctrl", "syscon";
			reg = <0xf8000000 0x1000>;
		};

		crg: clock-reset-controller@f8a22000 {
			compatible = "hisilicon,hi3716cv200-crg",
				"syscon", "simple-mfd";
			reg = <0xf8a22000 0x400>;
			#clock-cells = <1>;
			#reset-cells = <2>;
		};

		/*
		 * Same DMAC window, register set and request-line interrupt as
		 * the Hi3798MV100 instance (msp/drv/dmac/drv_dmac.h gives
		 * DMAC_BASE_REG 0xF9870000, DMAC_INT (30 + 32) and
		 * DMAC_CRG_BASE 0xF8A220A4 for this chip). dma-channels is
		 * carried over from the MV100 part and the PL08x driver honours
		 * it: channels 0..3 have to complete transfers here.
		 */
		dmac: dma-controller@f9870000 {
			compatible = "arm,pl080", "arm,primecell";
			/*
			 * The block reports 0x0a141080, which is bit for bit the ID
			 * the PL08x driver reserves for Samsung's PL080S variant:
			 * different channel configuration offset and 8-word list
			 * items, neither of which this has.  Declare the plain PL080
			 * ID, whose layout matches the register map here.
			 */
			arm,primecell-periphid = <0x00041080>;
			reg = <0xf9870000 0x10000>;
			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg HI3716CV200_DMAC_CLK>;
			clock-names = "apb_pclk";
			resets = <&crg 0xa4 4>;
			dma-channels = <4>;
			#dma-cells = <2>;
			memcpy-bus-width = <32>;
			memcpy-burst-size = <256>;
		};

		uart0: serial@f8b00000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0xf8b00000 0x1000>;
			interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg HI3716CV200_CLK_83P3M>,
				 <&crg HI3716CV200_CLK_83P3M>;
			clock-names = "uartclk", "apb_pclk";
		};

		/*
		 * The board's own /proc/iomem registers four more PL011 instances
		 * (`uart:1` 0xf8006000, `uart:2..4` 0xf8b02000/3000/4000), each a 4 KiB
		 * window, so these are the vendor's addresses rather than a stride guess.
		 * uart:1 sits in the SYS_CTRL window at 0xf8006000, not next to the others.
		 *
		 * Interrupt numbers come from mach/irqs.h's UART block (SPI 49..53); that
		 * header has been wrong for I2C, the SP804 timers and the MAC on this chip,
		 * but its UART0 entry is the one anchor the board confirms -- the console
		 * that works today is `GIC_SPI 49` and the vendor table counts it at ID 81.
		 * The remaining four are the contiguous rest of that block, and the board
		 * check that follows deliberately does not need them: PL011 requests the
		 * IRQ only when a port is opened, so the vendor's own /proc/interrupts
		 * lists just the console line and says nothing about the others.
		 */
		uart1: serial@f8006000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0xf8006000 0x1000>;
			interrupts = <GIC_SPI 50 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg HI3716CV200_UART1_CLK>,
				 <&crg HI3716CV200_UART1_CLK>;
			clock-names = "uartclk", "apb_pclk";
			status = "disabled";
		};

		uart2: serial@f8b02000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0xf8b02000 0x1000>;
			interrupts = <GIC_SPI 51 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg HI3716CV200_UART2_CLK>,
				 <&crg HI3716CV200_UART2_CLK>;
			clock-names = "uartclk", "apb_pclk";
			status = "disabled";
		};

		uart3: serial@f8b03000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0xf8b03000 0x1000>;
			interrupts = <GIC_SPI 52 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg HI3716CV200_UART3_CLK>,
				 <&crg HI3716CV200_UART3_CLK>;
			clock-names = "uartclk", "apb_pclk";
			status = "disabled";
		};

		uart4: serial@f8b04000 {
			compatible = "arm,pl011", "arm,primecell";
			reg = <0xf8b04000 0x1000>;
			interrupts = <GIC_SPI 53 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg HI3716CV200_UART4_CLK>,
				 <&crg HI3716CV200_UART4_CLK>;
			clock-names = "uartclk", "apb_pclk";
			status = "disabled";
		};

		/*
		 * WDG0 and WDG1 are SP805 blocks; the vendor s40_restart() uses
		 * WDG0 the same way. PERI_CRG94 (0x178) gates them: bits 0..3
		 * are wdg0..3_cken, bits 4..7 the matching srst_req. Both bits of the pair
		 * belong to &crg's clk_wdt0 row: this driver consumes no reset control, so a
		 * `resets` cell here would leave the dog held in reset with nobody to release
		 * it, and a dog in reset does not count (see crg-hi3716cv200.c).
		 */
		wdt0: watchdog@f8a2c000 {
			compatible = "arm,sp805", "arm,primecell";
			/*
			 * This instance has no PrimeCell ID header: with the block
			 * clocked and out of reset (CRG94 0x0000000F) it answers at
			 * offset 0x00 but 0xfe0..0xffc read eight zero words, while a
			 * PL061 bank read in the same batch answers 61 10 04 00 /
			 * 05 b1 -- so the zeros are the hardware, not the read method.
			 * Nothing here is a measured ID: the property below presets
			 * adev->periphid (of/platform.c) and amba_device_add() then
			 * skips amba_read_periphid() entirely, so /sys .../id just
			 * echoes this constant. The value is the driver's own table
			 * entry (sp805_wdt_ids, mask 0x00ffffff), so bits 23:0 are
			 * all that carries meaning here.
			 */
			arm,primecell-periphid = <0x00141805>;
			reg = <0xf8a2c000 0x1000>;
			interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&crg HI3716CV200_WDT0_CLK>, <&xtal24mhz>;
			clock-names = "wdog_clk", "apb_pclk";
			timeout-sec = <60>;
		};
	};
};

/ {
	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

};
