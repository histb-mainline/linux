menu "Hisilicon"

config SND_I2S_HI6210_I2S
	tristate "Hisilicon I2S controller"
	select SND_SOC_GENERIC_DMAENGINE_PCM
	help
	  Hisilicon I2S

config SND_SOC_HISTB_AIAO_I2S
	tristate "HiSTB AIAO I2S ports"
	depends on ARCH_HISI || COMPILE_TEST
	select SND_SOC_GENERIC_DMAENGINE_PCM
	help
	  Say Y here if you want to use the I2S ports of the AIAO audio block
	  found on HiSilicon STB SoCs such as the Hi3798MV100 and the
	  Hi3716CV200. Each port is an I2S master with its own clock generator and
	  its own ring-buffer engine.

config SND_SOC_HISTB_AIAO_CARD
	tristate "HiSTB AIAO Sound Card"
	depends on ARCH_HISI || COMPILE_TEST
	select SND_SOC_HISTB_AIAO_I2S
	help
	  Say Y here if you want the sound card of the AIAO audio block on
	  HiSilicon STB SoCs: the playback link hands the transmit port to the
	  HDMI transmitter, and the capture link reads back the serial stream
	  that same port puts on the wire. Nothing sits behind the capture
	  side, which is what keeps it from simple-audio-card.

endmenu
